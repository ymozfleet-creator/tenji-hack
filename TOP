<style>
:root{
  --navy:#0A1628;
  --navy-sub:#142238;
  --blue:#2E7CF6;
  --blue-soft:rgba(46,124,246,.12);
  --yellow:#E8FF3A;
  --white:#F7F9FC;
  --ink:#1E2A3A;
  --line:rgba(30,42,58,.12);
  --line-dark:rgba(247,249,252,.14);
  --radius:8px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Noto Sans JP',sans-serif;color:var(--ink);background:var(--white);line-height:1.9;font-size:16px;-webkit-font-smoothing:antialiased}
img{max-width:100%}
a{color:inherit;text-decoration:none}
.num{font-family:'Inter','Noto Sans JP',sans-serif;font-weight:800;letter-spacing:-.02em}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
section{padding:120px 0}
.sec-dark{background:var(--navy);color:var(--white)}
.sec-dark .sec-lead{color:rgba(247,249,252,.78)}
.eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.18em;color:var(--blue);border:1px solid currentColor;border-radius:999px;padding:4px 14px;margin-bottom:22px}
.sec-dark .eyebrow{color:var(--yellow);border-color:rgba(232,255,58,.5)}
h2{font-weight:900;font-size:clamp(26px,4vw,38px);line-height:1.55;letter-spacing:.01em;margin-bottom:22px}
.sec-lead{max-width:720px;font-size:16px;color:rgba(30,42,58,.82)}
.mark{background:linear-gradient(transparent 68%,rgba(232,255,58,.85) 68%);padding:0 2px}
.sec-dark .mark{background:linear-gradient(transparent 68%,rgba(232,255,58,.4) 68%)}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;font-size:16px;border-radius:var(--radius);padding:16px 34px;transition:transform .18s ease,box-shadow .18s ease,background .18s ease;cursor:pointer;border:2px solid transparent}
.btn:hover{transform:translateY(-2px)}
.btn:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
.btn-primary{background:var(--blue);color:#fff;box-shadow:0 6px 20px rgba(46,124,246,.35)}
.btn-primary:hover{box-shadow:0 10px 26px rgba(46,124,246,.45)}
.btn-ghost{border-color:rgba(247,249,252,.55);color:var(--white)}
.btn-ghost:hover{background:rgba(247,249,252,.08)}
.btn-ghost.on-light{border-color:var(--navy);color:var(--navy)}
.btn-ghost.on-light:hover{background:rgba(10,22,40,.05)}
.btn .arrow{transition:transform .18s ease}
.btn:hover .arrow{transform:translateX(4px)}

/* ---------- header ---------- */
header{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,22,40,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--line-dark)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px;max-width:1160px;margin:0 auto;padding:0 24px}
.logo{color:var(--white);font-weight:900;font-size:18px;letter-spacing:.06em;display:flex;align-items:baseline;gap:8px}
.logo small{font-size:11px;font-weight:500;color:rgba(247,249,252,.6);letter-spacing:.1em}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a{color:rgba(247,249,252,.85);font-size:14px;font-weight:500;transition:color .15s}
.nav-links a:hover{color:var(--yellow)}
.nav-cta{background:var(--blue);color:#fff!important;font-weight:700;padding:9px 20px;border-radius:var(--radius)}
.nav-cta:hover{color:#fff!important;filter:brightness(1.1)}
@media(max-width:820px){.nav-links a:not(.nav-cta){display:none}}

/* ---------- FV ---------- */
.fv{background:var(--navy);color:var(--white);padding:170px 0 0;position:relative;overflow:hidden}
.fv-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center}
.fv h1{font-weight:900;font-size:clamp(32px,5vw,52px);line-height:1.5;letter-spacing:.01em;margin:20px 0 26px}
.fv h1 .hl{color:var(--yellow)}
.fv-sub{color:rgba(247,249,252,.82);font-size:16.5px;max-width:520px}
.fv-cta{display:flex;gap:16px;flex-wrap:wrap;margin-top:38px}
.fv-label{font-size:13px;font-weight:700;letter-spacing:.16em;color:var(--yellow);border:1px solid rgba(232,255,58,.5);border-radius:999px;padding:5px 16px;display:inline-block}
.trust-bar{margin-top:64px;border-top:1px solid var(--line-dark);background:var(--navy-sub)}
.trust-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:0;max-width:1080px;margin:0 auto}
.trust-item{flex:1;min-width:220px;text-align:center;padding:26px 18px;border-left:1px solid var(--line-dark)}
.trust-item:first-child{border-left:none}
.trust-item .t-num{font-size:26px;color:var(--white)}
.trust-item .t-num b{color:var(--yellow)}
.trust-item .t-cap{font-size:13px;color:rgba(247,249,252,.62);margin-top:2px}
/* card visual */
.cards-visual{position:relative;height:340px}
.cardv{position:absolute;width:150px;height:88px;border-radius:6px;background:rgba(247,249,252,.07);border:1px solid rgba(247,249,252,.14);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.cardv::before{content:"";position:absolute;left:14px;top:16px;width:56%;height:7px;border-radius:4px;background:rgba(247,249,252,.22)}
.cardv::after{content:"";position:absolute;left:14px;top:34px;width:36%;height:5px;border-radius:4px;background:rgba(247,249,252,.14)}
.cardv.lit{background:rgba(46,124,246,.22);border-color:var(--blue);box-shadow:0 0 0 1px var(--blue),0 10px 30px rgba(46,124,246,.4)}
.cardv.lit::before{background:var(--blue)}
.cardv.lit .tag{position:absolute;right:-10px;top:-12px;background:var(--yellow);color:var(--navy);font-size:11px;font-weight:900;border-radius:999px;padding:2px 10px;letter-spacing:.05em}
@media(max-width:900px){.fv-grid{grid-template-columns:1fr}.cards-visual{display:none}}

/* ---------- pain ---------- */
.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
.pain-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:34px 28px;box-shadow:0 4px 18px rgba(10,22,40,.05)}
.pain-card .p-num{font-size:34px;color:var(--blue);display:block;margin-bottom:10px}
.pain-card h3{font-size:19px;font-weight:700;line-height:1.6;margin-bottom:12px}
.pain-card p{font-size:14.5px;color:rgba(30,42,58,.8)}
.bridge{margin-top:64px;text-align:center;font-weight:900;font-size:clamp(19px,2.6vw,24px);line-height:2}
@media(max-width:900px){.card-grid{grid-template-columns:1fr}}

/* ---------- process ---------- */
.proc-intro{max-width:760px;color:rgba(247,249,252,.82)}
.pipeline{margin-top:64px;display:grid;grid-template-columns:repeat(5,1fr);gap:0;position:relative}
.step{position:relative;padding:28px 20px 24px;border-left:1px solid var(--line-dark)}
.step:first-child{border-left:none}
.step .s-num{font-size:15px;color:var(--yellow);letter-spacing:.1em;font-weight:800}
.step h3{font-size:16.5px;font-weight:700;margin:8px 0 10px;line-height:1.55}
.step p{font-size:13px;color:rgba(247,249,252,.7);line-height:1.8}
.step.client{background:rgba(247,249,252,.05);border-radius:var(--radius)}
.step .who{display:inline-block;font-size:11px;font-weight:900;letter-spacing:.08em;border-radius:4px;padding:2px 8px;margin-bottom:8px}
.who.us{background:var(--blue);color:#fff}
.who.you{background:var(--yellow);color:var(--navy)}
.ours-band{margin-top:26px;border-top:2px solid var(--blue);padding-top:10px;font-size:13px;color:var(--blue);font-weight:700;letter-spacing:.06em;text-align:center}
.proc-note{margin-top:44px;font-size:14px;color:rgba(247,249,252,.62);border-left:3px solid var(--blue);padding-left:16px;max-width:720px}
@media(max-width:900px){.pipeline{grid-template-columns:1fr}.step{border-left:none;border-top:1px solid var(--line-dark)}.step:first-child{border-top:none}}

/* ---------- reasons ---------- */
.reason{display:grid;grid-template-columns:120px 1fr;gap:34px;padding:52px 0;border-top:1px solid var(--line);align-items:start}
.reason:last-of-type{border-bottom:1px solid var(--line)}
.reason .r-num{font-size:64px;color:var(--blue);line-height:1}
.reason .r-num span{display:block;font-size:12px;letter-spacing:.2em;color:rgba(30,42,58,.5);font-weight:700;margin-top:6px;font-family:'Noto Sans JP'}
.reason h3{font-size:22px;font-weight:900;line-height:1.6;margin-bottom:14px}
.reason p{color:rgba(30,42,58,.82);max-width:680px}
@media(max-width:700px){.reason{grid-template-columns:1fr;gap:10px}}

/* ---------- comparison ---------- */
.table-scroll{overflow-x:auto;margin-top:52px;-webkit-overflow-scrolling:touch}
table.compare{width:100%;min-width:720px;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.compare th,.compare td{padding:16px 18px;font-size:14.5px;text-align:left;border-top:1px solid var(--line);vertical-align:top}
.compare thead th{border-top:none;background:var(--navy);color:var(--white);font-weight:700;font-size:15px}
.compare thead th.hero-col{background:var(--blue);color:#fff}
.compare td:first-child{font-weight:700;background:rgba(10,22,40,.03);width:170px}
.compare td.hero-col{background:var(--blue-soft);font-weight:700;border-left:1px solid var(--blue);border-right:1px solid var(--blue)}
.compare tr:last-child td.hero-col{border-bottom:1px solid var(--blue)}
.table-note{font-size:12.5px;color:rgba(30,42,58,.6);margin-top:16px}

/* ---------- pricing ---------- */
.price-rows{max-width:760px;margin:56px auto 0}
.price-row{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:30px 8px;border-bottom:1px solid var(--line-dark);flex-wrap:wrap}
.price-row .p-name{font-weight:700;font-size:18px}
.price-row .p-name small{display:block;font-weight:400;font-size:12.5px;color:rgba(247,249,252,.6);margin-top:6px;line-height:1.8}
.price-row .p-val{font-size:34px;color:var(--white)}
.price-row .p-val b{border-bottom:4px solid var(--yellow);padding-bottom:2px}
.price-row .p-val small{font-size:15px;font-weight:500;color:rgba(247,249,252,.7);margin-left:4px}
.price-opt{max-width:760px;margin:30px auto 0;background:rgba(247,249,252,.05);border:1px dashed rgba(247,249,252,.3);border-radius:var(--radius);padding:22px 26px;font-size:14.5px;color:rgba(247,249,252,.85)}
.strict{max-width:760px;margin:80px auto 0}
.strict h3{font-size:clamp(21px,3vw,27px);font-weight:900;margin-bottom:18px;line-height:1.6}
.strict p{color:rgba(247,249,252,.8);font-size:15px}
.strict ul{list-style:none;margin:22px 0}
.strict li{padding:12px 0 12px 34px;position:relative;border-bottom:1px solid var(--line-dark);font-size:15px}
.strict li::before{content:"";position:absolute;left:4px;top:22px;width:16px;height:16px;border-radius:50%;background:var(--blue)}
.strict li.no::before{background:transparent;border:2px solid rgba(247,249,252,.35)}
.strict li.no{color:rgba(247,249,252,.5);text-decoration:line-through;text-decoration-color:rgba(232,255,58,.7);text-decoration-thickness:2px}

/* ---------- flow ---------- */
.flow{counter-reset:fstep;margin-top:56px;max-width:820px}
.fstep{display:grid;grid-template-columns:64px 1fr;gap:24px;padding:26px 0;border-top:1px solid var(--line);position:relative}
.fstep:last-child{border-bottom:1px solid var(--line)}
.fstep .f-num{width:52px;height:52px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
.fstep.client-step .f-num{background:var(--yellow);color:var(--navy)}
.fstep h3{font-size:17.5px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;line-height:1.6}
.fstep h3 .who{font-size:11px;font-weight:900;letter-spacing:.08em;border-radius:4px;padding:2px 8px}
.fstep p{font-size:14.5px;color:rgba(30,42,58,.8)}
.flow-time{margin-top:30px;font-weight:700;color:var(--blue);font-size:15px}

/* ---------- faq ---------- */
.faq-list{max-width:820px;margin:48px auto 0}
details{border:1px solid var(--line);border-radius:var(--radius);background:#fff;margin-bottom:14px;overflow:hidden}
summary{cursor:pointer;list-style:none;padding:20px 54px 20px 24px;font-weight:700;font-size:16px;position:relative;line-height:1.7}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";position:absolute;right:22px;top:50%;transform:translateY(-50%);font-size:22px;color:var(--blue);font-weight:400;transition:transform .2s}
details[open] summary::after{transform:translateY(-50%) rotate(45deg)}
details .faq-a{padding:0 24px 22px;font-size:14.5px;color:rgba(30,42,58,.82)}
summary:focus-visible{outline:3px solid var(--blue);outline-offset:-3px}

/* ---------- closing ---------- */
.closing{text-align:center}
.closing h2{font-size:clamp(26px,4.2vw,40px)}
.closing .c-sub{max-width:640px;margin:0 auto;color:rgba(247,249,252,.8)}
.closing .fv-cta{justify-content:center}
.micro{margin-top:26px;font-size:12.5px;color:rgba(247,249,252,.55);display:flex;gap:18px;justify-content:center;flex-wrap:wrap}
.micro span{position:relative}

/* ---------- footer ---------- */
footer{background:#060d18;color:rgba(247,249,252,.6);padding:44px 0;font-size:13px}
.foot-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.foot-links{display:flex;gap:22px;flex-wrap:wrap}
.foot-links a:hover{color:var(--yellow)}

/* ---------- reveal ---------- */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal.show{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none;transition:none}
  .btn,.btn .arrow{transition:none}
}
</style>
</head>
